{
  "version": 2,
  "builds": [
    {
      "src": "apps/server/src/main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/server/src/**/*",
          "tools/prisma/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/apps/server/dist/main.js"
    }
  ]
}
