{"builds": [
    {
      "src": "apps/client/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": "apps/client/.next"
      }
    },
    {
      "src": "apps/artboard/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": "apps/artboard/.next"
      }
    },
    {
      "src": "staticHtml/*/",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/client/(.*)",
      "dest": "/apps/client/$1"
    },
    {
      "src": "/artboard/(.*)",
      "dest": "/apps/artboard/$1"
    },
    {
      "src": "/staticHtml/(.*)",
      "dest": "/staticHtml/$1"
    }
  ]
}