{
    "version": 2,
    "builds": [
      {
        "src": "src/main.ts",
        "use": "@vercel/node",
        "config": {
            "distDir": "dist/apps/server" 
        }

      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "dist/apps/server/main.js" 
      }
    ]
  }